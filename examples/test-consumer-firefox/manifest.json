{
  "manifest_version": 3,
  "name": "ProtoConsent API Tester (Firefox)",
  "version": "0.0.1",
  "description": "Test extension for the ProtoConsent inter-extension messaging protocol.",
  "browser_specific_settings": {
    "gecko": {
      "id": "protoconsent-tester@example.org",
      "strict_min_version": "133.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icon.png",
      "128": "icon_128.png"
    }
  },
  "icons": {
    "32": "icon.png",
    "128": "icon_128.png"
  },
  "permissions": ["storage"]
}
